font=monospace 10
background-color=#1a1b26
text-color=#e0e6f7
border-color=#33467c
border-size=1
border-radius=0
padding=8
icons=0
default-timeout=5000
on-notify=exec sh -c 'makoctl mode | grep -qx do-not-disturb || mpv --no-video --really-quiet /usr/share/sounds/freedesktop/stereo/message.oga & sleep 6; pkill -RTMIN+10 waybar'

[urgency=high]
border-color=#f7768e

[mode=do-not-disturb]
invisible=1
